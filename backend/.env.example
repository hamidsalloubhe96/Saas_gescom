DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=saas_commerce
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

CENTRAL_DOMAINS=
